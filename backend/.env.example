# ============================================
# SimplifIQ Lead Enrichment Platform - Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# ============================================

# ============================================
# SERVER CONFIGURATION
# ============================================

# Backend server port (default: 5000)
PORT=5000

# Node environment (development | production)
NODE_ENV=development

# Frontend URL for CORS configuration
# Make sure this matches where your frontend is running
FRONTEND_URL=http://localhost:3000


# ============================================
# AI PROVIDER CONFIGURATION
# At least ONE of GROQ_API_KEY or GEMINI_API_KEY is REQUIRED
# Both can be provided; toggle between them in frontend
# ============================================

# Groq API Key (fast inference, recommended for speed)
# Get free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key (advanced reasoning, recommended for quality)
# Get free key at: https://makersuite.google.com
GEMINI_API_KEY=AIzaSyDyour_gemini_api_key_here


# ============================================
# EMAIL CONFIGURATION (SMTP)
# Gmail recommended - requires app password
# ============================================

# Gmail SMTP server
SMTP_HOST=smtp.gmail.com

# SMTP port
# Use 587 for TLS (SMTP_SECURE=false)
# Use 465 for SSL (SMTP_SECURE=true)
SMTP_PORT=587

# Use TLS for port 587 (false), SSL for port 465 (true)
SMTP_SECURE=false

# Your Gmail address (sender)
SMTP_USER=your-email@gmail.com

# Gmail APP PASSWORD (NOT regular password!)
# To generate: https://myaccount.google.com/apppasswords
# 1. Enable 2-Factor Authentication
# 2. Go to App Passwords
# 3. Select Mail and Windows Computer (or your OS)
# 4. Google generates 16-char password
# 5. Copy here (spaces removed)
SMTP_PASS=your16charapppassword

# Email "From" address
EMAIL_FROM=your-email@gmail.com

# Email "From" name (appears in recipient's inbox as sender name)
EMAIL_FROM_NAME=Lead Enrichment AI


# ============================================
# RATE LIMITING
# Prevents abuse of lead submission endpoint
# ============================================

# Time window in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Max number of requests within the time window
# Example: 10 leads per 15 minutes per IP
RATE_LIMIT_MAX_REQUESTS=10


# ============================================
# GOOGLE INTEGRATION (OPTIONAL - DISABLED BY DEFAULT)
# Sheets API: Log each lead to a Google Sheet
# Drive API: Archive PDF reports to Google Drive
# ============================================

# Enable/disable Google integrations
# Set to 'true' to enable, 'false' to disable
# App works perfectly without these enabled
ENABLE_GOOGLE_INTEGRATIONS=false

# Google Service Account Credentials (JSON format)
# Only required if ENABLE_GOOGLE_INTEGRATIONS=true
# 1. Create Google Cloud project
# 2. Create Service Account
# 3. Enable Google Sheets API + Google Drive API
# 4. Download JSON credentials
# 5. Convert to single line and paste here
# Format: {"type":"service_account","project_id":"...","private_key":"..."}
GOOGLE_SHEETS_CREDENTIALS={}

# Google Sheets Spreadsheet ID
# Found in URL: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
# Only required if ENABLE_GOOGLE_INTEGRATIONS=true
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Google Drive Folder ID (where PDFs will be archived)
# Found in URL: https://drive.google.com/drive/folders/{FOLDER_ID}
# Only required if ENABLE_GOOGLE_INTEGRATIONS=true
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here


# ============================================
# OPTIONAL: SUPABASE (For production database)
# ============================================

# Supabase project URL (not currently used, for future enhancement)
# SUPABASE_URL=your_supabase_url_here

# Supabase anonymous key (not currently used, for future enhancement)
# SUPABASE_ANON_KEY=your_supabase_key_here


# ============================================
# ENVIRONMENT NOTES
# ============================================
# 
# DEVELOPMENT:
#   - NODE_ENV=development
#   - FRONTEND_URL=http://localhost:3000
#   - SMTP_SECURE=false
#   - ENABLE_GOOGLE_INTEGRATIONS=false (recommended)
#
# PRODUCTION:
#   - NODE_ENV=production
#   - FRONTEND_URL=https://yourdomain.com
#   - SMTP_SECURE=true (if using port 465)
#   - Use secure secret management (not .env file)
#   - Enable GOOGLE_INTEGRATIONS if configured
#
# TROUBLESHOOTING:
#   - Email not sending? Check Gmail app password (not regular password)
#   - Google integration errors? Enable_GOOGLE_INTEGRATIONS=false to skip
#   - Port conflict? Change PORT=5001 and restart
#   - AI not responding? Verify API keys are correct
#
